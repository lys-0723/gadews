# PostgreSQL used by the aquaculture monitoring backend.
DATABASE_URL=postgresql://gadews:gadews_dev_only@127.0.0.1:54329/gadews
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Rich-Link API settings. Keep real values in .env.local, never in browser code.
RICH_LINK_BASE_URL=http://gy.rich-link.cn
RICH_LINK_ALLOW_INSECURE_HTTP=true
RICH_LINK_APP_ID=replace-with-provider-app-id
RICH_LINK_PUBLIC_KEY=replace-with-provider-public-key
RICH_LINK_DEVICE_ID=replace-with-provider-device-id
RICH_LINK_DEVICE_KEY=rich-link-primary
RICH_LINK_DEVICE_NAME=Primary pond monitoring device
RICH_LINK_SITE_ID=site-001
RICH_LINK_POND_ID=pond-001
RICH_LINK_TIME_ZONE=Asia/Shanghai
RICH_LINK_TIMEOUT_MS=15000
RICH_LINK_PAGE_LIMIT=1000
RICH_LINK_INITIAL_LOOKBACK_DAYS=1
RICH_LINK_POLL_INTERVAL_SECONDS=180

# Use RICH_LINK_DEVICES_JSON instead of the single-device variables above when
# multiple devices are connected. Example (keep it on one line):
# RICH_LINK_DEVICES_JSON=[{"key":"pond-a","upstreamDeviceId":"...","siteId":"site-001","pondId":"pond-a","name":"Pond A"}]

# Server-side API protection. Generate long random values for production.
COLLECTOR_SECRET=replace-with-a-long-random-collector-secret
AQUACULTURE_API_KEY=replace-with-a-long-random-read-api-key


# Knowledge assistant: server-only configuration. Leave key empty until configured.
GADEWS_AI_API_KEY=
GADEWS_AI_BASE_URL=https://ai.allrealai.com/v1
GADEWS_AI_MODEL=deepseek-v4.1-flash-1017
# Explicit choice: responses (default) or chat-completions. No automatic fallback.
GADEWS_AI_PROTOCOL=responses

# Account storage. For local development omit both values to use .local-accounts/.
# On Vercel configure a persistent libsql:// endpoint and its write token.
GADEWS_ACCOUNT_DB_URL=
GADEWS_ACCOUNT_DB_TOKEN=
